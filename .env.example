NODE_ENV=production
PORT=3000
APP_URL=https://meet.example.com
# Required host identity. HOST_EMAIL must be the verified Google account you connect.
HOST_NAME=Your Name
HOST_EMAIL=you@example.com
# Seeds a new database; later profile/timezone edits belong in the admin dashboard.
HOST_TIMEZONE=UTC
# Generate locally with: npm run secrets
ADMIN_PASSWORD=
TOKEN_ENCRYPTION_KEY=
DB_PATH=./data/meetly.sqlite
# Google Cloud OAuth Web application credentials (set in hosting secrets)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable ONLY behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
